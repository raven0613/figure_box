        "weightMultiplier": 0.15,
        "recap": "none",
        "maxPerReturn": 1
      },
      "need": {
        "weightMultiplier": 1,
        "recap": "auto",
        "maxPerReturn": 4
      },
      "environment": {
        "weightMultiplier": 0.45,
        "recap": "auto",
        "maxPerReturn": 2
      },
      "global": {
        "weightMultiplier": 0,
        "recap": "none",
        "maxPerReturn": 0
      }
    },
    "motivation": {
      "idle": {
        "weightMultiplier": 0.25,
        "recap": "none"
      },
      "findFood": {
        "weightMultiplier": 1.1
      },
      "rest": {
        "weightMultiplier": 0.9
      },
      "play": {
        "weightMultiplier": 0.75
      },
      "chat": {
        "weightMultiplier": 0.5,
        "maxPerReturn": 1
      }
