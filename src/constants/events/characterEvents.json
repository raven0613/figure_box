          "summary": "{participantNameList} 湊在一起聊起了八卦。",
          "detail": "話題讓兩人越聊越投入。"
        },
        "activity": {
          "key": "chat.gossip",
          "type": "chat",
          "startPhase": "active",
          "group": {
            "inviteNearbyRange": 2,
            "minParticipants": 2,
            "maxParticipants": 2
          },
          "joinable": true,
          "durationMs": 16000,
          "refreshDurationOnJoin": false,
          "joinWindowMs": 6000,
          "dialogueScriptId": "activity-chat-gossip",
          "dialogueSubjectSelection": {
            "sourceRole": "initiator",
