            "minCount": 1,
            "count": 2,
            "excludeParticipants": true
          },
          "cooldowns": {
            "selfMs": 12000,
            "targetMs": 10000,
            "pairMs": 36000,
            "category": "social_gossip",
            "repeatPenalty": {
              "windowMs": 150000,
              "weightMultiplierPerRepeat": 0.4,
              "maxRepeats": 3
            }
          },
          "rolls": [
            {
              "id": "gossipResult",
              "resolvesActivity": true,
              "branches": [
                {
                  "id": "sharedSurprise",
                  "baseWeight": 60,
                  "performanceId": "social.chat.gossip.sharedSurprise",
                  "weightModifiers": [
                    {
                      "path": "target.personality.interpersonalAttitude",
                      "operator": ">=",
                      "value": 4,
                      "add": 15
                    },
                    {
                      "path": "target.relationshipToInitiator.feeling",
                      "operator": "in",
                      "value": ["warm", "like", "fond", "secret_crush", "open_crush", "love"],
                      "add": 15
                    }
                  ],
                  "effects": {
                    "relationshipIntimacyDelta": 1,
                    "moodValueDelta": 1
                  },
                  "memoryEffects": [
                    {
                      "recipientRole": "target",
                      "target": "dialogueSubject",
                      "memoryType": "impression",
                      "countDelta": 1,
                      "startedByRole": "initiator"
                    }
                  ],
                  "offlineRecap": {
                    "summary": "{participantNameList} 聊完八卦後，一起為內容感到驚訝。",
                    "detail": "分享秘密讓兩人的距離稍微拉近了。"
                  }
                },
                {
                  "id": "playfulFakeout",
                  "baseWeight": 40,
                  "performanceId": "social.chat.gossip.playfulFakeout",
                  "weightModifiers": [
                    {
                      "path": "initiator.personality.noveltyPreference",
                      "operator": ">=",
                      "value": 4,
                      "add": 20
                    },
                    {
                      "path": "initiator.personality.emotionalExpression",
                      "operator": ">=",
                      "value": 4,
                      "add": 10
                    }
                  ],
                  "effects": {
                    "relationshipIntimacyDelta": 1
                  },
                  "effectsByRole": {
                    "initiator": {
                      "moodValueDelta": 1
                    },
                    "target": {
                      "moodValueDelta": -1
                    }
                  },
                  "memoryEffects": [
                    {
                      "recipientRole": "target",
                      "target": "dialogueSubject",
                      "memoryType": "impression",
                      "countDelta": 1,
                      "startedByRole": "initiator"
                    }
                  ],
                  "offlineRecap": {
                    "summary": "{participantNameList} 聊著聊著，才發現其中一人只是在開玩笑。",
                    "detail": "惡作劇讓一人很開心，另一人卻有點不高興。"
                  }
                }
              ]
            }
          ],
