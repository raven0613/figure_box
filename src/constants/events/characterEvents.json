      {
        "id": "chat.argument.preference",
        "baseWeight": 8,
        "presentationTags": ["expressionBubble.angry", "motion.turn"],
        "performanceId": "social.chat.argument.preference",
        "offlineRecap": {
          "summary": "{participantNameList} 為了彼此的喜好爭論了起來。",
          "detail": "兩人各自堅持自己的看法。"
        },
        "activity": {
          "key": "chat.argument.preference",
          "type": "chat",
          "startPhase": "active",
          "group": {
            "inviteNearbyRange": 2,
            "minParticipants": 2,
            "maxParticipants": 2
          },
          "joinable": true,
          "durationMs": 20000,
          "refreshDurationOnJoin": false,
          "joinWindowMs": 8000,
          "cooldowns": {
            "selfMs": 14000,
            "targetMs": 12000,
            "pairMs": 42000,
            "category": "social_argument",
            "repeatPenalty": {
              "windowMs": 180000,
              "weightMultiplierPerRepeat": 0.35,
              "maxRepeats": 2
            }
          },
          "rolls": [
            {
              "id": "argumentReaction",
              "branches": [
                {
                  "id": "defendPreference",
                  "baseWeight": 50,
                  "performanceId": "social.chat.argument.preference.defend",
                  "weightModifiers": [
                    {
                      "path": "target.personality.emotionalExpression",
                      "operator": ">=",
                      "value": 4,
                      "add": 20
                    },
                    {
                      "path": "target.status.mood",
                      "operator": "in",
                      "value": ["nervous", "upset", "angry"],
                      "add": 10
                    }
                  ]
                },
                {
                  "id": "considerOtherSide",
                  "baseWeight": 50,
                  "performanceId": "social.chat.argument.preference.consider",
                  "weightModifiers": [
                    {
                      "path": "target.personality.interpersonalAttitude",
                      "operator": ">=",
                      "value": 4,
                      "add": 20
                    },
                    {
                      "path": "target.relationshipToInitiator.feeling",
                      "operator": "in",
                      "value": ["warm", "like", "fond", "secret_crush", "open_crush", "love"],
                      "add": 25
                    },
                    {
                      "path": "target.status.mood",
                      "operator": "in",
                      "value": ["relaxed", "happy"],
                      "multiplier": 1.25
                    }
                  ]
                }
              ]
            },
            {
              "id": "argumentResult",
              "resolvesActivity": true,
              "branches": [
                {
                  "id": "agreed",
                  "baseWeight": 50,
                  "performanceId": "social.chat.argument.preference.agreed",
                  "weightModifiers": [
                    {
                      "path": "target.personality.interpersonalAttitude",
                      "operator": ">=",
                      "value": 4,
                      "add": 20
                    },
                    {
                      "path": "target.relationshipToInitiator.feeling",
                      "operator": "in",
                      "value": ["warm", "like", "fond", "secret_crush", "open_crush", "love"],
                      "add": 30
                    },
                    {
                      "path": "target.status.mood",
                      "operator": "in",
                      "value": ["relaxed", "happy"],
                      "multiplier": 1.25
                    }
                  ],
                  "effects": {
                    "relationshipIntimacyDelta": 1,
                    "moodValueDelta": 4
                  },
                  "memoryEffects": [
                    {
                      "recipientRole": "both",
                      "target": "otherParticipant",
                      "memoryType": "argument",
                      "countDelta": 1,
                      "startedByRole": "initiator"
                    }
                  ],
                  "offlineRecap": {
                    "summary": "{participantNameList} 爭論了一番，最後接受了彼此的看法。",
                    "detail": "這次爭論反而讓他們更了解對方。"
                  }
                },
                {
                  "id": "fellApart",
                  "baseWeight": 50,
                  "performanceId": "social.chat.argument.preference.fellApart",
                  "weightModifiers": [
                    {
                      "path": "target.personality.emotionalExpression",
                      "operator": ">=",
                      "value": 4,
                      "add": 20
                    },
                    {
                      "path": "target.relationshipToInitiator.feeling",
                      "operator": "in",
                      "value": ["hate", "dislike", "wary"],
                      "add": 30
                    },
                    {
                      "path": "target.status.mood",
                      "operator": "in",
                      "value": ["nervous", "upset", "angry"],
                      "multiplier": 1.25
                    }
                  ],
                  "effects": {
                    "relationshipIntimacyDelta": -1,
                    "moodValueDelta": -5
                  },
                  "memoryEffects": [
                    {
                      "recipientRole": "both",
                      "target": "otherParticipant",
                      "memoryType": "argument",
                      "countDelta": 1,
                      "startedByRole": "initiator"
                    }
                  ],
                  "offlineRecap": {
                    "summary": "{participantNameList} 因為喜好不同而不歡而散。",
                    "detail": "兩人的氣氛比爭論前更僵了。"
                  }
                },
                {
                  "id": "unexpectedAgreement",
                  "baseWeight": 15,
                  "conditions": [
                    {
                      "path": "activity.rolls.argumentReaction.selectedBranchId",
                      "operator": "==",
                      "value": "considerOtherSide"
                    }
                  ],
                  "performanceId": "social.chat.argument.preference.unexpectedAgreement",
                  "weightModifiers": [
                    {
                      "path": "initiator.personality.interpersonalAttitude",
                      "operator": ">=",
                      "value": 4,
                      "add": 20
                    },
                    {
                      "path": "target.relationshipToInitiator.feeling",
                      "operator": "in",
                      "value": ["warm", "like", "fond"],
                      "multiplier": 1.5
                    }
                  ],
                  "effects": {
                    "relationshipIntimacyDelta": 2,
                    "moodValueDelta": 6
                  },
                  "memoryEffects": [
                    {
                      "recipientRole": "both",
                      "target": "otherParticipant",
                      "memoryType": "argument",
                      "countDelta": 1,
                      "startedByRole": "initiator"
                    }
                  ],
                  "offlineRecap": {
                    "summary": "{participantNameList} 原本爭論不休，最後卻意外達成共識。",
                    "detail": "意外的共同點讓他們親近了不少。"
                  }
                }
              ]
            }
          ],
          "joinRequirements": {
            "type": "none"
          }
